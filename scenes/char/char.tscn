[sub_resource type="GDScript" id="GDScript_dbuk4"]
script/source = "extends Button


func _on_pressed() -> void:
	var char_select = get_parent()
	if char_select.num % 2 == 0:
		get_tree().change_scene_to_file(\"res://scenes/school_parts/corridor.tscn\")
	else:
		get_tree().change_scene_to_file(\"res://scenes/school_parts/corridor2.tscn\")
	
"

